# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=15567
LOG_LEVEL=info

# Where Scalar / the OpenAPI document are served
DOCS_PATH=/docs
OPENAPI_PATH=/docs/openapi.json

# ─── Postgres ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=carcare
DB_PASSWORD=carcare
DB_NAME=carcare

# Multi-tenancy is opt-in. When enabled each tenant gets its own database
# named "${DB_NAME}-<tenantName>", cloned from the template database.
DB_MULTITENANCY_ENABLED=false
DB_MULTITENANCY_SUFFIX_TENANCY=tenancy
DB_MULTITENANCY_SUFFIX_TEMPLATE=template

# ─── JWT ────────────────────────────────────────────────────────────────────
# Must be >= 32 bytes. Generate with: openssl rand -hex 64
JWT_SECRET=
# Session timeout in seconds (the .NET default was 8 hours)
JWT_SESSION_TIMEOUT=28800
# Shared with the frontend; sent as `serverSecret` on the login request
JWT_CONSUMER_SECRET=

# ─── CORS ───────────────────────────────────────────────────────────────────
# "open" allows any origin. "restricted" only allows CORS_APP_HOST.
CORS_MODE=open
CORS_APP_HOST=localhost

# ─── SMTP (outgoing estimates / invoices) ───────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
MAIL_FROM_ADDRESS=no-reply@carcare.local
MAIL_FROM_NAME=CarCare

# ─── PDF rendering ──────────────────────────────────────────────────────────
PDF_DIRECTORY=./pdf
# Chrome/Chromium executable. Install with: npx playwright install chromium
PLAYWRIGHT_CHROMIUM_PATH=

# ─── Rate limits (max requests per time window, in seconds) ─────────────────
RATE_LIMIT_TENANT_MAX=300
RATE_LIMIT_TENANT_WINDOW_SECONDS=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_PICTURE_MAX=60
RATE_LIMIT_PICTURE_WINDOW=60
RATE_LIMIT_DEMO_MAX=1
RATE_LIMIT_DEMO_WINDOW=86400

# ─── Misc ───────────────────────────────────────────────────────────────────
LOGIN_FAILURE_DELAY_MS=3000
MAX_PROFILE_IMAGE_BYTES=5242880
