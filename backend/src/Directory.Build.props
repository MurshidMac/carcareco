<Project>
  <PropertyGroup>
    <VersionFile>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\VERSION'))</VersionFile>
    <VersionPrefix Condition="Exists('$(VersionFile)')">$([System.IO.File]::ReadAllText('$(VersionFile)').Trim())</VersionPrefix>
    <VersionPrefix Condition="!Exists('$(VersionFile)')">0.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
  </PropertyGroup>
</Project>
